FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=vendos-nje-celes-te-gjate-dhe-te-rastesishëm
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/piss_db

# --- AI ---------------------------------------------------------------
# Një shërbim i vetëm (p.sh. "groq" ose "ollama") ose një zinxhir i ndarë me presje.
# Në zinxhir, kur një shërbim arrin limitin ose nuk përgjigjet, kalohet te tjetri.
# Shërbimet pa çelës API anashkalohen automatikisht.
AI_PROVIDER=groq,mistral,gemini,ollama

# Groq (falas): https://console.groq.com  -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (opsional): nuk është më falas dhe kërkon kartë.
# https://cloud.cerebras.ai  -> API Keys
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Mistral (falas, "Free mode"): https://console.mistral.ai  -> API Keys
# Kërkesat në planin falas mund të përdoren për trajnim (shiko README).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter (opsional, modele ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini (falas me limit): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama (lokal, pa internet). gemma3:4b e shkruan shqipen më mirë se qwen2.5.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=600

AI_TIMEOUT_SECONDS=120
# Sa pret studenti më së shumti për një përmbledhje ose test (të gjitha thirrjet bashkë).
AI_TOTAL_TIMEOUT_SECONDS=90
GROQ_TIMEOUT_SECONDS=45
GEMINI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=3
AI_MAX_INPUT_CHARS=30000
AI_CHUNK_CHARS=4000
MAX_CONTENT_LENGTH=10485760
